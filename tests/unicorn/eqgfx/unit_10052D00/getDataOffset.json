        { "addr": "@record", "offset": "0x0", "u32": "0xfffffff3" }
      ],
      "expect": { "ret": "0xffffffff" }
    },
    {
      "name": "maxint overflows into the sign bit",
      "args": ["@record"],
      "memory": [
        { "addr": "@record", "offset": "0x0", "u32": "0x7fffffff" }
      ],
      "expect": { "ret": "0x8000000b" }
    },
    {
      "name": "minint stays at the top of the range",
      "args": ["@record"],
      "memory": [
        { "addr": "@record", "offset": "0x0", "u32": "0x80000000" }
      ],
      "expect": { "ret": "0x8000000c" }
    },
    {
      "name": "low 16 bits zero: the full 32-bit dword is loaded",
