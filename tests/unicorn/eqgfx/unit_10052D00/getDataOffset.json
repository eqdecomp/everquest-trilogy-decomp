      "memory": [
        { "addr": "@record", "offset": "0x0", "u32": "0x10000" }
      ],
      "expect": { "ret": "0x1000c" }
    },
    {
      "name": "byte-order witness: 0x12345678 + 0xc",
      "args": ["@record"],
      "memory": [
        { "addr": "@record", "offset": "0x0", "u32": "0x12345678" }
      ],
