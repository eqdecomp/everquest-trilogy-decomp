    {
      "name": "offset -12 lands exactly on zero (round-trip of the +0xc)",
      "args": ["@record"],
      "memory": [
        { "addr": "@record", "offset": "0x0", "u32": "0xfffffff4" }
      ],
      "expect": { "ret": 0 }
