  "cases": [
    {
      "name": "first frame",
      "args": ["@sprite", 0],
      "expect": {"ret": "0x11111111"}
    },
    {
      "name": "typical middle frame",
      "args": ["@sprite", 1],
      "expect": {"ret": "0x22222222"}
