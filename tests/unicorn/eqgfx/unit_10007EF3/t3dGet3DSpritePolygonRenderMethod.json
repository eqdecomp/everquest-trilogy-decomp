      "args": ["@sprite", 4],
      "expect": {"ret": 0}
    },
    {
      "name": "index past count",
      "args": ["@sprite", 5],
      "expect": {"ret": 0}
    },
    {
      "name": "count zero",
      "args": ["@sprite", 0],
