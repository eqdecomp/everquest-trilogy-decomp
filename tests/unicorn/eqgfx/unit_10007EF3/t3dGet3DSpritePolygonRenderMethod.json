      "expect": {"ret": 0}
    },
    {
      "name": "count one, first frame",
      "args": ["@sprite", 0],
      "memory": [{"addr": "@definition", "offset": "0x20", "u32": 1}],
      "expect": {"ret": "0x11111111"}
    },
    {
      "name": "own frame array null falls back to parent",
      "args": ["@sprite", 1],
      "memory": [{"addr": "@sprite", "offset": "0x18", "u32": 0}],
      "expect": {"ret": "0xaaaa0002"}
    },
    {
      "name": "fallback last in-range frame",
      "args": ["@sprite", 3],
      "memory": [{"addr": "@sprite", "offset": "0x18", "u32": 0}],
      "expect": {"ret": "0xaaaa0004"}
    },
    {
      "name": "fallback with index equals count",
      "args": ["@sprite", 4],
      "memory": [{"addr": "@sprite", "offset": "0x18", "u32": 0}],
      "expect": {"ret": 0}
    },
    {
      "name": "fallback with count zero",
      "args": ["@sprite", 0],
      "memory": [{"addr": "@sprite", "offset": "0x18", "u32": 0},
                 {"addr": "@definition", "offset": "0x20", "u32": 0}],
      "expect": {"ret": 0}
    },
    {
      "name": "unsigned compare: high-bit count keeps index below it",
      "args": ["@sprite", 5],
      "memory": [{"addr": "@definition", "offset": "0x20", "u32": "0x80000000"}],
      "expect": {"ret": "0x66666666"}
    },
    {
      "name": "unsigned compare: all-ones count keeps small index in range",
      "args": ["@sprite", 7],
      "memory": [{"addr": "@definition", "offset": "0x20", "u32": "0xffffffff"}],
      "expect": {"ret": "0x77777777"}
    },
    {
      "name": "unsigned compare: high-bit index is out of range",
      "args": ["@sprite", "0x80000000"],
      "expect": {"ret": 0}
    },
    {
      "name": "index all ones",
      "args": ["@sprite", "0xffffffff"],
      "expect": {"ret": 0}
    },
    {
      "name": "count two, second frame",
      "args": ["@sprite", 1],
      "memory": [{"addr": "@definition", "offset": "0x20", "u32": 2}],
      "expect": {"ret": "0x22222222"}
    }
